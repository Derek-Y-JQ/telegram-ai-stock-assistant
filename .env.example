# === Required ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
LLM_API_KEY=your_llm_api_key_here

# === Optional Proxy (ONLY for Telegram; keeps domestic A-share data sources direct) ===
# Leave empty on cloud servers (Railway/Zeabur) or VPN/TUN mode.
# Example: http://127.0.0.1:7890
TELEGRAM_PROXY=

# === LLM Configuration (OpenAI-compatible, 2026 current models) ===
# DeepSeek: https://api.deepseek.com
#   models: deepseek-chat (V3.2) | deepseek-reasoner (R1 thinking)
# OpenAI:   https://api.openai.com/v1
#   models: gpt-5-mini | gpt-5 | gpt-4.1
# Gemini:   https://generativelanguage.googleapis.com/v1beta/openai/
#   models: gemini-2.5-flash | gemini-2.5-pro
# Qwen:     https://dashscope.aliyuncs.com/compatible-mode/v1
#   models: qwen3-max | qwen-plus
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=3000

# === Interactive Mini App / K-Line Dashboard ===
WEBAPP_ENABLED=true
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
# Set to your public HTTPS URL (e.g. https://your-app.up.railway.app) to enable
# the interactive Telegram Mini App button directly inside iPhone Telegram!
WEBAPP_URL=

# === Scheduled Briefings & Price Alerts ===
TIMEZONE=Asia/Shanghai
MORNING_BRIEF_TIME=09:00
EVENING_BRIEF_TIME=15:30
ALERT_POLL_SECONDS=300

# === Optional Data Sources ===
# AkShare (A-share) & yfinance (US/HK) work out of the box without any token.
TUSHARE_TOKEN=

# === Storage & Cache ===
DATABASE_PATH=data/stock_bot.db
CACHE_TTL_SECONDS=300
LOG_LEVEL=INFO
