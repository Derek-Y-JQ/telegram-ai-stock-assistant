# === Required ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
LLM_API_KEY=your_deepseek_or_openai_api_key_here

# === LLM Configuration (OpenAI-compatible) ===
# DeepSeek: https://api.deepseek.com (model: deepseek-chat / deepseek-reasoner)
# OpenAI:   https://api.openai.com/v1 (model: gpt-4o-mini / gpt-4o)
# Qwen:     https://dashscope.aliyuncs.com/compatible-mode/v1 (model: qwen-plus)
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2500

# === Optional Data Sources ===
# AkShare is used by default (free, no token required).
# Provide TUSHARE_TOKEN if you want Tushare fallback/enrichment.
TUSHARE_TOKEN=

# === Storage & Cache ===
DATABASE_PATH=data/stock_bot.db
CACHE_TTL_SECONDS=300
LOG_LEVEL=INFO
